[Unit]
Description=Gem Encyclopedia PWA static server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/gem-identify-pwa
ExecStart=/usr/bin/python3 -m http.server 8133 --bind 0.0.0.0 --directory /home/ubuntu/gem-identify-pwa
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
